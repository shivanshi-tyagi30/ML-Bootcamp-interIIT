# FAST laptop / CPU-only profile: small 4B models, about 2-3x faster than .env.cpu, lower-quality record.
#   Windows:  copy .env.cpu-fast .env      Linux/macOS:  cp .env.cpu-fast .env
# Then:  python -m app.prefetch
# Anything not listed here uses the defaults from .env.example.

DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173

# Whisper picks large-v3-turbo, int8, beam 1 and all cores on CPU.
WHISPER_MODEL=auto
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# Parakeet (NeMo) does not install on Windows; low-confidence words are marked disputed instead.
RECHECK_ENABLED=false
LOWCONF_DISPUTE_THRESHOLD=0.45

# Speaker labels: uses ECAPA-TDNN (default) or pyannote if configured with HF_TOKEN.
DIARIZATION_ENABLED=true
DIARIZATION_BACKEND=ecapa
# Set to the number of people in the meeting when you know it (most accurate); 0 = detect automatically.
# Rename "Speaker N" to a name said in the meeting ("I am Shivanshi", "Hello Prachi" + her reply)
SPEAKER_NAMES_FROM_TRANSCRIPT=true
DIARIZATION_NUM_SPEAKERS=0
# When detecting: higher = fewer speakers. Raise it if one person is split in two, lower it if two people merge.
ECAPA_DISTANCE_THRESHOLD=0.6
HF_TOKEN=

# Smaller models that still follow the JSON schemas well. qwen3 runs with thinking turned off.
LLM_BACKEND=ollama
LLM_BASE_URL=http://localhost:11434/v1
# Two 4B models (about 3 GB each) both stay loaded, so nothing reloads between steps.
LM1_MODEL=qwen3:4b
LM2_MODEL=gemma3:4b
LM1_UNLOAD_BEFORE_LM2=false
# Load every model when the backend starts (the first job doesn't wait for loading).
WARMUP_ON_START=true

# Fewer, larger LM1 windows = less repeated prompt reading on CPU.
# A 5-10 minute meeting is refined in one call.
LM1_WINDOW_SEGMENTS=120
LM1_CONTEXT_SEGMENTS=3

# LM2 skips the written scratchpad: roughly half the tokens to generate.
LM2_SCRATCHPAD=false
# Separate vocabulary call: auto = skip it for short meetings (refined in one call), always, never
VOCAB_PASS=auto
LLM_TIMEOUT_SEC=1200
LLM_MAX_RETRIES=1
# Keep both models in memory forever: no reload between steps or between users.
OLLAMA_KEEP_ALIVE=-1m
