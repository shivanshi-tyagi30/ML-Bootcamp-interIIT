# Google Colab profile (free T4 GPU, 16 GB). The notebook copies this to .env and fills in HF_TOKEN.
DATA_DIR=./data
SERVE_FRONTEND=true

# Whisper picks large-v3, float16, beam 5 on the GPU (best accuracy).
WHISPER_MODEL=auto
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# Parakeet (NeMo) is not installed on Colab to keep setup short; unclear words are marked instead.
RECHECK_ENABLED=false
LOWCONF_DISPUTE_THRESHOLD=0.45

# Speaker labels: pyannote when HF_TOKEN is set (accept the model terms on Hugging Face first), else ECAPA.
DIARIZATION_ENABLED=true
DIARIZATION_BACKEND=auto
DIARIZATION_NUM_SPEAKERS=0
SPEAKER_NAMES_FROM_TRANSCRIPT=true
HF_TOKEN=

# Language models on the GPU. A T4 has 16 GB, so LM1 is unloaded before LM2 loads.
LLM_BACKEND=ollama
LLM_BASE_URL=http://localhost:11434/v1
LM1_MODEL=qwen3:8b
LM2_MODEL=gemma3:12b
LM1_UNLOAD_BEFORE_LM2=true
# On a GPU the think-first scratchpad is affordable and gives better decisions and action items.
LM2_SCRATCHPAD=true
VOCAB_PASS=auto
LLM_TIMEOUT_SEC=900
LLM_MAX_RETRIES=2
OLLAMA_KEEP_ALIVE=-1m
WARMUP_ON_START=true
