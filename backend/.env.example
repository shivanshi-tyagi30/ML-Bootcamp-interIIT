# Copy to .env and adjust. All values shown are the defaults.

# Root for `jobs/` and `trace.db`
DATA_DIR=./data
# Upload size limit
MAX_FILE_MB=200
# Audio length limit
MAX_DURATION_MIN=120
# Below this → E_NO_SPEECH
MIN_SPEECH_SEC=2.0
# Allowed extensions
ALLOWED_EXT=mp3,wav,m4a,ogg,flac,webm,mp4,aac
# faster-whisper model: `auto` = large-v3 on a GPU, large-v3-turbo on CPU (about 6x faster, near-equal accuracy)
WHISPER_MODEL=auto
# `auto`, `cuda` or `cpu` (cuda falls back to cpu when no GPU is found)
WHISPER_DEVICE=auto
# `auto` = float16 on GPU, int8 on CPU
WHISPER_COMPUTE_TYPE=auto
# 0 = auto (5 on GPU, 1 on CPU)
WHISPER_BEAM_SIZE=0
# 0 = all CPU cores
WHISPER_CPU_THREADS=0
# Without Parakeet, Whisper words below this probability are marked disputed (0 = off)
LOWCONF_DISPUTE_THRESHOLD=0.45
# Parakeet second opinion
RECHECK_ENABLED=true
# NeMo model id
PARAKEET_MODEL=nvidia/parakeet-tdt-0.6b-v2
# Word probability below this → flag
RECHECK_CONF_THRESHOLD=0.60
# 3-word window mean below this → flag
RECHECK_WINDOW_CONF=0.70
# Padding around flagged spans
RECHECK_PAD_SEC=2.0
# Max share of audio duration to re-check
RECHECK_MAX_SHARE=0.35
# Random audit share of unflagged segments
RECHECK_AUDIT_SHARE=0.05
# Speaker identification / diarization: auto, ecapa (SpeechBrain, default, no token needed), or pyannote
DIARIZATION_ENABLED=true
DIARIZATION_BACKEND=ecapa
ECAPA_MODEL=speechbrain/spkrec-ecapa-voxceleb
# Number of speakers if known (0 = detect); detection threshold (higher = fewer speakers)
# Rename "Speaker N" to a name said in the meeting ("I am Shivanshi", "Hello Prachi" + her reply)
SPEAKER_NAMES_FROM_TRANSCRIPT=true
DIARIZATION_NUM_SPEAKERS=0
ECAPA_DISTANCE_THRESHOLD=0.6
# Needed only if using pyannote
HF_TOKEN=
# `ollama` or `vllm`
LLM_BACKEND=ollama
# OpenAI-compatible endpoint
LLM_BASE_URL=http://localhost:11434/v1
# LM1 model id on the server
LM1_MODEL=qwen3:14b
# LM2 model id on the server
LM2_MODEL=gemma3:27b
# Per-call timeout
LLM_TIMEOUT_SEC=600
# JSON repair retries
LLM_MAX_RETRIES=2
# Largest context window requested from Ollama (sized per call: 8k/16k/32k)
LLM_MAX_CONTEXT=32768
# How long Ollama keeps a model loaded after a call (negative = forever, so no user waits for a reload)
OLLAMA_KEEP_ALIVE=-1m
# true: LM2 writes its reasoning first (spec). false: about half the output, much faster on CPU
LM2_SCRATCHPAD=true
# Separate vocabulary call: auto = skip it for short meetings (refined in one call), always, never
VOCAB_PASS=auto
# Load every model before the server accepts uploads (run `python -m app.prefetch` at deploy time first)
WARMUP_ON_START=true
# Free LM1's memory before LM2. Only for big models on a 16 GB laptop: LM1 then reloads on every job
LM1_UNLOAD_BEFORE_LM2=false
# Target segments per window
LM1_WINDOW_SEGMENTS=40
# Read-only context on each side
LM1_CONTEXT_SEGMENTS=5
# Drop edits below this
LM1_MIN_CONFIDENCE=0.70
# Guard sound-alike threshold
SOUND_ALIKE_THRESHOLD=0.75
# rapidfuzz partial_ratio for evidence quotes
QUOTE_MATCH_THRESHOLD=90
# Above this → chunked mode
LM2_MAX_INPUT_TOKENS=24000
# Frontend origin(s), comma-separated
CORS_ORIGINS=http://localhost:5173
# Max simultaneous uploads before the API returns 429
MAX_CONCURRENT_UPLOADS=3
# Optional: separate OpenAI-compatible server for LM2 (needed with vLLM, which serves one model per server)
LM2_BASE_URL=
