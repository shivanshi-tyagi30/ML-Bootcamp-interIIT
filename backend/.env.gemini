# CLOUD profile: Google Gemini for both LM1 and LM2 (free API key: aistudio.google.com -> Get API key).
#   Windows:  copy .env.gemini .env      Linux/macOS:  cp .env.gemini .env
# Paste the key below, or leave it empty and paste it in the app's API key box instead.
# Whisper and speaker labels still run on this machine. The transcript text is sent to Google.
DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Any OpenAI-compatible service works too, e.g. CLOUD_BASE_URL=https://api.openai.com/v1 and a GPT model.
CLOUD_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
CLOUD_TIMEOUT_SEC=300
# Thinking models: "low" keeps answers fast; "" uses the provider default.
CLOUD_REASONING_EFFORT=low
# Use the local Ollama model only when the cloud cannot be reached at all (no internet).
CLOUD_FALLBACK_LOCAL=true
# The local fallback models (only used without internet).
LLM_BACKEND=ollama
LLM_BASE_URL=http://localhost:11434/v1
LM1_MODEL=qwen3:4b
LM2_MODEL=gemma3:4b

WHISPER_MODEL=auto
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
RECHECK_ENABLED=false
DIARIZATION_ENABLED=true
DIARIZATION_BACKEND=ecapa
SPEAKER_NAMES_FROM_TRANSCRIPT=true
# A cloud model can afford to reason first: better decisions and action items.
LM2_SCRATCHPAD=true
VOCAB_PASS=auto
LLM_MAX_RETRIES=2
WARMUP_ON_START=true
