# BEST-QUALITY laptop / CPU-only profile (no NVIDIA GPU), for 16 GB of RAM or more.
#   Windows:  copy .env.cpu .env      Linux/macOS:  cp .env.cpu .env
# Then:  python -m app.prefetch
# For quicker but weaker results use .env.cpu-fast instead. With an NVIDIA GPU, use the defaults (.env.example).

DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173

# Whisper large-v3-turbo (int8, all cores) with beam search 5: more accurate words, names and terms than
# greedy decoding, at a small extra cost because turbo's decoder is tiny.
WHISPER_MODEL=auto
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_BEAM_SIZE=5

# Parakeet (NeMo) does not install on Windows; low-confidence words are marked disputed instead.
RECHECK_ENABLED=false
LOWCONF_DISPUTE_THRESHOLD=0.45

# Speaker labels: pyannote (most accurate) when HF_TOKEN is set and pyannote.audio is installed
# (pip install pyannote.audio; accept the terms of pyannote/speaker-diarization-community-1 and
# pyannote/segmentation-3.0 on huggingface.co); otherwise ECAPA voice embeddings, no account needed.
DIARIZATION_ENABLED=true
DIARIZATION_BACKEND=auto
HF_TOKEN=
# Set to the number of people in the meeting when you know it (most accurate); 0 = detect automatically.
DIARIZATION_NUM_SPEAKERS=0
# When detecting: higher = fewer speakers. Raise it if one person is split in two, lower it if two people merge.
ECAPA_DISTANCE_THRESHOLD=0.6
# Rename "Speaker N" to a name said in the meeting ("I am Shivanshi", "Hello Prachi" + her reply)
SPEAKER_NAMES_FROM_TRANSCRIPT=true

# The strongest Qwen (LM1) and Gemma (LM2) that fit a 16 GB laptop. qwen3 runs with thinking off.
LLM_BACKEND=ollama
LLM_BASE_URL=http://localhost:11434/v1
LM1_MODEL=qwen3:8b
LM2_MODEL=gemma3:12b
# They do not fit in 16 GB together, so only one is in memory at a time (swapping to disk would be far slower).
LM1_UNLOAD_BEFORE_LM2=true
WARMUP_ON_START=true

# A 5-10 minute meeting is refined in one call.
LM1_WINDOW_SEGMENTS=120
LM1_CONTEXT_SEGMENTS=3

# LM2 first writes its evidence and classification (scratchpad), then the record: better decisions,
# proposals and action items, at the cost of more writing time.
LM2_SCRATCHPAD=true
# Separate vocabulary call: auto = skip it for short meetings (refined in one call), always, never
VOCAB_PASS=auto
LLM_TIMEOUT_SEC=1800
LLM_MAX_RETRIES=2
OLLAMA_KEEP_ALIVE=-1m
